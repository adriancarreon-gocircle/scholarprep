{
  "name": "scholarprep",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "react-scripts": "5.0.1",
    "stripe": "^22.1.0",
    "react-helmet-async": "^2.0.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "react-snap"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "devDependencies": {
    "react-snap": "^1.23.0"
  },
  "reactSnap": {
    "include": [
      "/",
      "/login",
      "/signup",
      "/forgot-password",
      "/support",
      "/pdf-generator",
      "/exams/acer-selective",
      "/exams/aast-scholarship",
      "/exams/edutest-selective",
      "/exams/naplan",
      "/exams/aset-gate-wa",
      "/exams/peac-wa",
      "/exams/ignite-sa",
      "/exams/seal-vic",
      "/exams/sehs-vic",
      "/exams/oc-nsw",
      "/exams/hast",
      "/exams/icas"
    ],
    "skipThirdPartyRequests": true,
    "headless": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "inlineCss": true
  }
}